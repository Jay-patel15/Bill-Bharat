# =============================================================
# BillBharat — local development environment
#
# Copy to .env.local for `npm run dev`. The packaged desktop app needs
# NONE of this: it generates its own session secret on first launch and
# stores data under %APPDATA%\BillBharat.
# =============================================================

# -------------------------------------------------------------
# SESSION
# -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_32_PLUS_RANDOM_CHARS
SESSION_COOKIE_NAME=bb_session

# -------------------------------------------------------------
# DATA LOCATION (optional)
# -------------------------------------------------------------
# Where billbharat.db and uploaded files live. Defaults to ./.data in dev.
# BILLBHARAT_DATA_DIR=D:\BillBharatData

# -------------------------------------------------------------
# AI PDF READING (optional — purchase/sales PDF auto-fill)
# -------------------------------------------------------------
# The only features that reach the internet. Leave blank to disable them;
# everything else works fully offline.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=

# -------------------------------------------------------------
# APP
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BillBharat
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------
# DEVELOPMENT ONLY
# -------------------------------------------------------------
# Set to 1 to skip login entirely and inject a dummy admin user.
DEV_BYPASS_AUTH=0
