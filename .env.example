# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=bb_session

# Optional Google OAuth (login with Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Google Sheets / Drive (Service Account) ---
# Paste full service account JSON as a single-line string, OR set GOOGLE_CREDENTIALS_BASE64.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_BASE64=

# Sheet that acts as the application database. Share it with the service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Drive folder where invoices, logos, purchase PDFs are stored. Share with the service account.
GOOGLE_DRIVE_FOLDER_ID=

# --- AI ---
GEMINI_API_KEY=
# Optional fallback
OPENAI_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_NAME=BillBharat
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Local dev only ---
# Set to 1 to skip auth entirely and inject a dummy user.
# Lets you preview the UI without signup or Google credentials. NEVER set in production.
DEV_BYPASS_AUTH=0

# Storage backends. Auto-detected: if Google credentials are missing,
# the app falls back to JSON files (.data/) and local uploads (public/uploads/).
# Force a backend with these:
#   DATA_BACKEND=json | google
#   STORAGE_BACKEND=local | drive
DATA_BACKEND=
STORAGE_BACKEND=
JSON_DATA_DIR=
