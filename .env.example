# =============================================================
# BillBharat — Environment Variables
# Copy this file to .env.local and fill in all required values.
# NEVER commit .env.local to version control.
# =============================================================

# -------------------------------------------------------------
# SUPABASE
# -------------------------------------------------------------
# Project URL and service-role key, from Supabase Dashboard → Project Settings → API.
# The service-role key is server-side only — never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# Postgres connection string, from Project Settings → Database → Connection Pooling.
DATABASE_URL=postgresql://postgres.your-project-ref:CHANGE_ME@aws-0-region.pooler.supabase.com:6543/postgres

# Storage bucket name (create as a public bucket in the Supabase dashboard).
SUPABASE_STORAGE_BUCKET=billbharat-storage

# -------------------------------------------------------------
# AUTHENTICATION (JWT)
# -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_32_PLUS_RANDOM_CHARS
SESSION_COOKIE_NAME=bb_session

# -------------------------------------------------------------
# GOOGLE OAUTH (Optional — Login with Google)
# -------------------------------------------------------------
# Leave blank to disable Google login. Email/password login always available.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# -------------------------------------------------------------
# AI FEATURES (OPENROUTER / GEMINI)
# -------------------------------------------------------------
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
GEMINI_API_KEY=

# -------------------------------------------------------------
# APP SETTINGS
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BillBharat
# Set to your public domain (used in reset password URLs, etc.)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# -------------------------------------------------------------
# DEVELOPMENT ONLY — NEVER SET IN PRODUCTION
# -------------------------------------------------------------
# Set to 1 to bypass authentication entirely (inject a dummy admin user).
DEV_BYPASS_AUTH=0
