# =============================================================
# BillBharat — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# =============================================================

# -------------------------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------------------------
# Full connection string for the PostgreSQL database.
# In Docker Compose, the hostname is the service name "postgres".
DATABASE_URL=postgresql://admin:CHANGE_ME@postgres:5432/billbharat_db

# These are used by the postgres service in docker-compose.yml
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=billbharat_db

# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
# Optional. If not set, Redis features (caching, OTP) are disabled gracefully.
REDIS_URL=redis://redis:6379

# -------------------------------------------------------------
# MINIO (Object Storage)
# -------------------------------------------------------------
# Hostname of the MinIO server. Use "minio" in Docker Compose.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# Set to "true" only if MinIO is behind HTTPS (usually false for internal Docker network)
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_8_CHARS
MINIO_BUCKET=billbharat-storage

# Storage backend: minio | drive | local
# Default for self-hosted: minio
STORAGE_BACKEND=minio

# -------------------------------------------------------------
# AUTHENTICATION (JWT)
# -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_32_PLUS_RANDOM_CHARS
SESSION_COOKIE_NAME=bb_session

# -------------------------------------------------------------
# GOOGLE OAUTH (Optional — Login with Google)
# -------------------------------------------------------------
# Leave blank to disable Google login. Email/password login always available.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# -------------------------------------------------------------
# GOOGLE DRIVE / SHEETS (Optional — Legacy cloud storage backend)
# -------------------------------------------------------------
# Only needed if STORAGE_BACKEND=drive. Leave blank for MinIO.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=

# -------------------------------------------------------------
# AI FEATURES
# -------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# -------------------------------------------------------------
# APP SETTINGS
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BillBharat
# Set to your public domain (used in reset password URLs, etc.)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# -------------------------------------------------------------
# SMTP (Optional — Email delivery for password resets)
# -------------------------------------------------------------
# Leave blank to use the built-in "return reset URL in API response" mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# -------------------------------------------------------------
# DEVELOPMENT ONLY — NEVER SET IN PRODUCTION
# -------------------------------------------------------------
# Set to 1 to bypass authentication entirely (inject a dummy admin user).
DEV_BYPASS_AUTH=0
